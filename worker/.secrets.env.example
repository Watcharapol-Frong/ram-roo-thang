# คัดลอกไฟล์นี้เป็น worker/.secrets.env แล้วใส่ค่าจริง (gitignore ไว้แล้ว ห้าม commit ตัวจริง)
#
# ใส่ครั้งเดียวจบ — `npm run deploy` จะยิง secrets ขึ้น production ให้ทุกครั้งที่ deploy
# ถ้ามีอะไรมาล้าง secrets บน Cloudflare (เช่น worker ถูกเขียนทับ) การ deploy ครั้งถัดไปจะกู้คืนให้เอง
#
# LINE_CHANNEL_SECRET       -> LINE Developers Console > แท็บ Basic settings
# LINE_CHANNEL_ACCESS_TOKEN -> LINE Developers Console > แท็บ Messaging API (ตัว long-lived ท้ายหน้า)

LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
